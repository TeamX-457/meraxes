# Copy to .env and add your keys (never commit .env)

USE_OPENAI=auto
DEFAULT_MODEL_TIER=strong
LLM_PROVIDER_ORDER=openai,groq,openrouter,google,ollama

OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o
OPENAI_MODELS=gpt-4o,gpt-4o-mini

GROQ_API_KEY=gsk-your-groq-key
GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant

OPENROUTER_API_KEY=sk-or-v1-your-key
OPENROUTER_MODELS=openai/gpt-4o-mini,anthropic/claude-3.5-haiku

GOOGLE_API_KEY=your-google-ai-studio-key
GOOGLE_MODELS=gemini-2.0-flash,gemini-1.5-flash

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Silent training (V2 cloud chats → V1 intents + Ollama export)
SILENT_V1_TRAINING=true
EXPORT_LOCAL_FINETUNE=true
V1_TRAIN_EVERY_N=5
OLLAMA_BASE_MODEL=qwen2.5:7b
OLLAMA_CUSTOM_MODEL=nova-v2-learned
OLLAMA_REBUILD_EVERY_N=10
AUTO_BUILD_OLLAMA=false

PORT=8006
HOST=0.0.0.0
DEBUG=false
